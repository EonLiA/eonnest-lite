# ===== 必填 =====
# Telegram Bot Token（找 @BotFather 创建 bot 拿到）
TELEGRAM_BOT_TOKEN=
# 你自己的 Telegram 数字 ID（找 @userinfobot 拿到）。bot 只会理这个人
TELEGRAM_OWNER_ID=

# API 提供商：anthropic 或 openrouter
LLM_PROVIDER=anthropic
# 对应提供商的 API key（只填一个就行）
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ===== 选填（不填就不开这个功能）=====
# DashScope key（阿里云百炼，用于语义向量检索）。不填则退化成关键词检索，也能用
DASHSCOPE_API_KEY=
# Brave Search key。不填则没有联网搜索工具
BRAVE_SEARCH_KEY=
